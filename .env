# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=8521376955:AAF5bhaVX0SavTZX1312K8pklZ74NHx5mTE

# Comma-separated Telegram user IDs that get the Admin Panel (grant/revoke access, proxy settings).
# Admins do NOT automatically get monitoring access — grant yourself access too via the Admin Panel if needed.
ADMIN_TELEGRAM_IDS=7743406267

# Discord webhook URL (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
# Can also be set later from the bot's Settings button.
DISCORD_WEBHOOK_URL=

# Optional: how often to check each account, in ms (5 min default)
CHECK_INTERVAL_MS=300000

# Optional: max accounts that can be watched at once
MAX_ACCOUNTS=30

# Optional: proxy (used as a fallback if a direct check fails). Can also be set
# later from the Admin Panel -> Proxy Settings.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
